# Copy this file to ".env" in the project root (next to the backend/ folder).
# Never commit .env or share it: it holds your database password.

# ---- Online database (Supabase) ----
# Supabase dashboard > Project Settings > Database > Connection string.
# Use the "Session pooler" string (works on IPv4 networks), and replace the
# [YOUR-PASSWORD] part with your database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Alternative to DATABASE_URL, no URL-encoding needed. Use this instead if
# your password contains characters like @ # / : ? %
# DB_DRIVER=postgresql
# DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your_password_here
# DB_NAME=postgres

# ---- One-time migration: your existing local MySQL (only for load_data.py --from-source) ----
# SOURCE_DATABASE_URL=mysql://root:your_password@localhost:3306/customerai

# ---- Frontend ----
# Where the Streamlit app finds the API. Change this when the API is hosted.
API_BASE_URL=http://localhost:8000

# ---- API ----
# Turns on saving from the Upload and Analyze page. Pick a long random phrase and keep it
# private: anyone who knows it can replace your data. Leave it out to switch saving off.
ADMIN_KEY=choose-a-long-private-phrase
# MAX_UPLOAD_MB=50
# Optional:
# Comma-separated list of allowed frontend origins once hosted. Default is "*".
# CORS_ORIGINS=https://your-app.streamlit.app
